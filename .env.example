# Copy to .env and fill locally. Never commit real credentials.
HOST=127.0.0.1
PORT=4175
# For public deployment, set the exact HTTPS origin (no trailing slash).
# PUBLIC_ORIGIN=https://your-domain.example
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments stay unavailable until keys, HTTPS origin and an explicit course allowlist are configured.
# Only non-demo course IDs can be enabled. Confirm sale authorization, delivery and refund terms first.
PAYMENT_COURSE_IDS=
# Example after approval: PAYMENT_COURSE_IDS=honglou-close-reading

# WeChat Pay: direct merchant Native payment, API v3, platform PUBLIC KEY mode.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL=
# Paths are read on the server only. Keep keys under .data/keys/ (gitignored) or outside this repository.
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=
WECHAT_API_V3_KEY=

# Alipay: direct merchant Face-to-Face Payment (trade.precreate), RSA2 public key mode.
# An application ID alone is insufficient: the matching payment product must be approved.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=